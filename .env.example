################################################
# 시스템 권한 (WSL/Linux 권한 동기화)
# 각 개발자는 자기 PC에서 `id -u`, `id -g`로 확인한 값을 설정합니다.
################################################
APP_UID=1000
APP_GID=1000
# local이면 Xdebug가 설치되고, production이면 설치되지 않습니다.
APP_ENV=local

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
